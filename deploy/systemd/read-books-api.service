[Unit]
Description=Read Books FastAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/mengalong/website/read-books
EnvironmentFile=/home/mengalong/website/read-books/.env
ExecStart=/root/anaconda3/bin/conda run --no-capture-output -n read-books uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
