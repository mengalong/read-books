[Unit]
Description=Read Books Next.js service
After=network.target read-books-api.service
Wants=read-books-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/mengalong/website/read-books
EnvironmentFile=/home/mengalong/website/read-books/.env
Environment=NODE_ENV=production
ExecStart=/root/anaconda3/bin/conda run --no-capture-output -n read-books npm --prefix apps/web run start -- --hostname 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
